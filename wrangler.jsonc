{
  // Cloudflare Workers static-assets configuration (Workers Builds).
  // Vercel ignores this file; it is only read by Wrangler.
  "name": "averacapital",
  "compatibility_date": "2026-11-15",
  "assets": {
    "directory": "./dist/nuriberry-app/browser",
    // Angular is a client-side SPA: serve index.html for unknown routes
    // so /pricing, /readiness, /dashboard, etc. work on refresh.
    "not_found_handling": "single-page-application"
  }
}
